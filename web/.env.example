# Base URL of the FastAPI service (no trailing slash, no /api/v1).
# Read in the browser, so it must start with NEXT_PUBLIC_ and is baked in at build time.
# "/" means the same origin as the web app: the Docker image uses that and forwards
# /api/v1 to the API (see API_INTERNAL_URL in next.config.ts).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of the web app, for canonical URLs, sitemap.xml and robots.txt (#52).
SITE_URL=http://localhost:3000
