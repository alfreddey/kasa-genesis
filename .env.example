# Settings the API reads at startup (api/kasa/config.py). Copy this file to .env, or export
# the variables in your shell, or prefix a command:  KASA_VOICE=tone make run
# Real environment variables win over .env. Every setting has a working default.

# Voice engine: mms (real model, needs `make setup-tts`), abena (hosted), tone (instant beeps), silent,
# or any "module:attribute" that builds a Synthesizer. See api/kasa/voices.py.
KASA_VOICE=mms

# Override the Hugging Face model per language for the mms voice, as JSON.
# Defaults are in api/kasa/languages.py.
# TTS_MODELS={"aka": "facebook/mms-tts-aka", "ewe": "facebook/mms-tts-ewe"}

# Abena AI hosted voice, used when KASA_VOICE=abena. Create a free key in the Abena
# dashboard (https://abena.mobobi.com/playground/sdk/dashboard/). Pricing and commercial
# terms are not published: confirm them with Abena before launch.
# ABENA_API_KEY=
# ABENA_BASE_URL=https://abena.mobobi.com/playground/api/v1
# ABENA_VOICES={"aka": "abena_twi_high", "ewe": "mawuli_ewe"}

# Feature flags to turn on (comma-separated, "-name" forces one off). See api/kasa/flags.py.
KASA_FLAGS=

# Where story JSON files live. Defaults to the repo's stories/ folder.
# STORIES_DIR=/app/stories

# Browser origins allowed to call the API (CORS), comma-separated. "*" allows any.
# The default is the Next.js dev server.
ALLOWED_ORIGINS=http://localhost:3000

# Folder for cached audio, so a story is synthesized only once, even across restarts.
# Leave empty to cache in memory instead (lost on restart, CACHE_MAX_ITEMS files kept).
# Docker Compose defaults it to /data/audio, a named volume.
CACHE_DIR=
# CACHE_MAX_ITEMS=64

# Interactive API docs at /docs and /redoc (the schema at /openapi.json always stays).
# Set false in production.
# ENABLE_DOCS=true

# Abuse and overload protection (api/kasa/limits.py). Cached audio is never limited.
# Set false in production so the public only hears stored story audio (POST /tts gives 403).
# ALLOW_FREE_TEXT_TTS=true
# New syntheses allowed per client IP per minute, then 429 with Retry-After. 0 means no limit.
# Behind a reverse proxy, run uvicorn with --proxy-headers so the real client IP is used.
# TTS_RATE_LIMIT_PER_MINUTE=30
# Syntheses running at once. Others wait up to SYNTHESIS_WAIT_SECONDS, then get a 503.
# MAX_CONCURRENT_SYNTHESIS=2
# SYNTHESIS_WAIT_SECONDS=10

# Logging (docs/observability.md). LOG_JSON=true writes one JSON object per line.
# LOG_LEVEL=INFO
# LOG_JSON=false
# GET /metrics in Prometheus format. Keep it off the public internet; METRICS_TOKEN adds a bearer check.
# METRICS_ENABLED=true
# METRICS_TOKEN=

# --- Docker Compose only (docker-compose.yml) ---
# Install PyTorch in the API image. Set false for a small image, with KASA_VOICE=tone.
# INSTALL_TTS=true
# Host ports. The API port is bound to 127.0.0.1; put a reverse proxy in front of WEB_PORT.
# WEB_PORT=3000
# API_PORT=8000
